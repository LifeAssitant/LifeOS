# Application
APP_NAME=LifeOS
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:8081","exp://127.0.0.1:8081"]

# Database
DATABASE_URL=postgresql+asyncpg://lifeos:lifeos@localhost:5432/lifeos

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth / JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Encryption for BYOK Gemini keys (Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=

# Gemini (hosted mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
HOSTED_CHAT_CREDIT_COST=1
FREE_STARTER_CREDITS=50

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_CREDITS=
STRIPE_SUCCESS_URL=http://localhost:5173/settings?credits=success
STRIPE_CANCEL_URL=http://localhost:5173/settings?credits=cancel
CREDITS_PER_PURCHASE=100

# Expo push (optional server-side)
EXPO_ACCESS_TOKEN=

# Reminder worker
REMINDER_POLL_SECONDS=30
DEFAULT_REMIND_BEFORE_MINUTES=15
