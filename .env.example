# Application
APP_NAME=LifeOS
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:8081","exp://127.0.0.1:8081"]
# For production, allow the HTTPS website and "null" for the packaged Electron file renderer.

# Database — Supabase Postgres (Project Settings → Database → Connection string)
# Use the pooler URI and swap the scheme to postgresql+asyncpg://
# Example:
# DATABASE_URL=postgresql+asyncpg://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Docker API/worker can use Supabase's IPv4 Session Pooler during migration.
# Copy the Session Pooler URI from Supabase Dashboard -> Connect, and URL-encode
# special characters in the password. Leave blank to use local Docker Postgres.
SUPABASE_DATABASE_URL=

# Auth / JWT (LifeOS session tokens after email or Google login)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Password recovery email (SMTP). Keep credentials in the deployment secret store.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
PUBLIC_APP_URL=https://brainlesshuman.com

# Supabase Auth (Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Required for self-service deletion of accounts linked to Supabase Auth.
# Configure only as a deployment secret; never expose this key in an app build.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (same client as Supabase Auth → Google provider)
# Enable Calendar API on the Google Cloud project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:8000/api/v1/calendar/google/callback
DESKTOP_OAUTH_SUCCESS_URL=lifeos://auth/calendar-connected

# Encryption for BYOK Gemini keys + Google Calendar refresh tokens
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Gemini (hosted mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
HOSTED_CHAT_CREDIT_COST=1
FREE_STARTER_CREDITS=50

# Razorpay (credentials stay in the backend deployment secret store)
BILLING_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Create a monthly subscription plan in the Razorpay dashboard and copy its plan ID.
RAZORPAY_MONTHLY_PLAN_ID=
# Recommended India-first starting offer: Rs 399/month and 60 credits weekly.
RAZORPAY_MONTHLY_PRICE_PAISE=39900
SUBSCRIPTION_WEEKLY_CREDITS=60
RAZORPAY_SUBSCRIPTION_TOTAL_CYCLES=120
# One-time top-up: Rs 99 for 20 credits.
RAZORPAY_TOPUP_AMOUNT_PAISE=9900
RAZORPAY_TOPUP_CREDITS=20

# Expo push (optional server-side)
EXPO_ACCESS_TOKEN=

# Reminder worker
REMINDER_POLL_SECONDS=30
DEFAULT_REMIND_BEFORE_MINUTES=15

# Langfuse — conversation traces (US cloud). Export starts when both keys are set.
# Project Settings → API Keys. Do not commit the real keys.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# When true, spans include the user message and assistant reply.
TRACE_CAPTURE_CONTENT=false

# Optional OpenTelemetry export besides Langfuse (Phoenix, Jaeger, Tempo, Honeycomb).
OTEL_TRACES_ENABLED=false
OTEL_SERVICE_NAME=lifeos-api
# Base URL. /v1/traces is appended when it is missing.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# Print spans in the API logs. In development, console export also turns on when
# OTEL_TRACES_ENABLED=true and neither Langfuse nor an OTLP endpoint is set.
OTEL_TRACES_CONSOLE=false
